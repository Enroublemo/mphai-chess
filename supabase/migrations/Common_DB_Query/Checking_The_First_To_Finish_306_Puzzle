SELECT 
  p.username,
  p.full_name,
  COUNT(DISTINCT pa.puzzle_id) AS total_puzzles_solved,
  MAX(pa.attempted_at) AS completion_time
FROM public.profiles p
JOIN public.puzzle_attempts pa ON p.id = pa.student_id
WHERE p.role = 'student'
  AND pa.is_correct = true
GROUP BY p.id, p.username, p.full_name
HAVING COUNT(DISTINCT pa.puzzle_id) = (SELECT COUNT(*) FROM public.puzzles)
ORDER BY completion_time ASC;